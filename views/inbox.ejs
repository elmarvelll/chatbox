<%- include('partials/header') %>
        </div>
      </div>  
      <div class="chat_container" id="chat_container">
        <div class="reciever_title"><%= reciever %></div>
        <div class="chat_area" id="chat_area">
          <% if (messages && messages.length) { %>
            <% messages.forEach((message) => { %>
              <div class="<%= message.sender_id === UserId ? 'sender_chats' : 'reciever_chats' %>"><%= message.message %></div>
            <% }) %>
          <% } else { %>
            <div class="empty_chat_state">No messages yet. Start the conversation.</div>
          <% } %>
        </div>

        <div class="send_message show" id="send_message">
          <form id="message_form" class="message_form">
            <input type="text" autofocus="off" autocomplete="off" name="message" id="chat" class="chatInput" placeholder="Type a message">
            <button type="submit" class="message_button" id="message_button">Send</button>
          </form>
        </div>
      </div>
    </div>
  </section>

<%- include('partials/footer') %>
